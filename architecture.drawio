<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="stray-love-arch" name="STRAY Love Ph - Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="STRAY Love Ph Foundation — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="680" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== ACTORS ===================== -->
        <mxCell id="user" value="User / Adopter" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="50" height="90" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="50" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== FRONTEND ===================== -->
        <mxCell id="fe" value="React Frontend&#10;(Hosted on Vercel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="120" width="240" height="420" as="geometry" />
        </mxCell>
        <mxCell id="fe-pages" value="Pages&#10;Home · Login · Register · Pets · Admin Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe-comp" value="Components&#10;Navbar · Footer (Emotion styled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="245" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe-router" value="react-router-dom&#10;(client-side routing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="310" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe-api" value="API Layer&#10;axios + React Query&#10;(stores JWT, calls /api/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="375" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== BACKEND ===================== -->
        <mxCell id="be" value="Express Backend — backend_temp/server.js&#10;(Vercel Serverless Function)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="320" height="540" as="geometry" />
        </mxCell>
        <mxCell id="be-mw" value="Middleware&#10;CORS · JSON body parser (50mb) · connectDB() guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="150" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be-auth" value="Auth API&#10;/api/auth/send-otp · verify-otp · register · login · me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="be-admin" value="Admin API&#10;/api/admin/users · verify · suspend · stats · activities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="295" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="be-pets" value="Pet API&#10;GET / POST / PUT / DELETE  /api/pets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be-sec" value="Security&#10;jsonwebtoken (JWT) · bcryptjs (password hashing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="435" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be-otp" value="OTP Store&#10;in-memory Map (10-min expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="580" y="500" width="135" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be-models" value="Mongoose Models&#10;User · Pet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="725" y="500" width="135" height="55" as="geometry" />
        </mxCell>

        <!-- ===================== DATA / EXTERNAL ===================== -->
        <mxCell id="db" value="MongoDB Atlas (Cloud)&#10;Database: stray_love_ph&#10;&#10;Collections:&#10;• users&#10;• pets" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="180" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mail" value="Gmail SMTP&#10;(via Nodemailer + App Password)&#10;&#10;Sends:&#10;• OTP verification&#10;• Approval email&#10;• Rejection email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <mxCell id="e-user-fe" value="HTTPS" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="user" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-admin-fe" value="HTTPS" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="admin" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-fe-be" value="REST  /api/*&#10;(JWT Bearer token)" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="fe-api" target="be-mw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-be-db" value="Mongoose&#10;mongodb+srv (TLS)" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="be-models" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-be-mail" value="SMTP&#10;(App Password)" style="endArrow=classic;html=1;fontSize=11;strokeWidth=2;" edge="1" parent="1" source="be-auth" target="mail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="250" />
              <mxPoint x="930" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="Deployment&#10;• Frontend + Backend → Vercel&#10;• Database → MongoDB Atlas&#10;• Email → Gmail SMTP&#10;&#10;Env vars (Vercel): MONGODB_URI, JWT_SECRET, EMAIL_USER, EMAIL_PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="580" width="360" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
